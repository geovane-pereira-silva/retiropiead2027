+  }
+}
+
+/* ─── Hero ────────────────────────────────────────────────────────────── */
+.lp-hero {
+  position: relative;
+  isolation: isolate;
+  padding: clamp(3rem, 9vw, 7rem) 0 clamp(3.5rem, 8vw, 6rem);
+  background:
+    radial-gradient(60rem 34rem at 85% -10%, rgba(255, 90, 31, 0.32), transparent 60%),
+    radial-gradient(48rem 30rem at -10% 20%, rgba(98, 170, 255, 0.2), transparent 60%),
+    linear-gradient(180deg, #0b0c18 0%, var(--lp-bg) 100%);
+}
+.lp-net {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  width: 100%;
+  height: 100%;
+  opacity: 0.55;
+  pointer-events: none;
+  mask-image: linear-gradient(180deg, #000 30%, transparent 95%);
+  -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 95%);
+}
+.lp-hero-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.55rem;
+  padding: 0.45rem 0.95rem;
+  border-radius: 999px;
+  border: 1px solid rgba(255, 176, 46, 0.4);
+  background: rgba(255, 176, 46, 0.08);
