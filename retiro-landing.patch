new file mode 100644
index 0000000..8da047d
--- /dev/null
+++ b/tests/inscricao.test.ts
@@ -0,0 +1,156 @@
+// Testes das regras de inscrição. Rodar: npx tsx --test tests/*.test.ts
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  calcularIdade,
+  cpfValido,
+  faixaPorIdade,
+  formatarCpf,
+  formatarTelefone,
+  higienizarCelula,
+  montarCorpo,
+  normalizarTelefone,
+  telefoneValido,
+  validar,
+  VALORES_VAZIOS,
+  type FormValues,
+} from "../src/lib/inscricao.ts";
+import { evento } from "../src/content/evento.ts";
+
+const ctx = { dataReferencia: evento.inicioData, hoje: "2026-10-21", faixas: evento.faixas };
+
+const base = (extra: Partial<FormValues> = {}): FormValues => ({
+  ...VALORES_VAZIOS,
+  nomeCompleto: "Maria da Silva",
+  dataNascimento: "1995-06-15",
+  cpf: "529.982.247-25",
+  telefone: "(35) 99999-1234",
+  whatsapp: "(35) 99999-1234",
+  igreja: "Primeira Assembleia de Deus",
+  cidade: "Santa Rita do Sapucaí",
+  emergenciaNome: "José da Silva",
+  emergenciaTelefone: "(35) 98888-4321",
+  aceiteRegras: true,
+  aceitePrivacidade: true,
+  ...extra,
+});
+
+test("data de início do evento", () => assert.equal(evento.inicioData, "2027-02-12"));
+
+test("CPF: válidos e inválidos", () => {
+  assert.equal(cpfValido("529.982.247-25"), true);
+  assert.equal(cpfValido("11144477735"), true);
+  assert.equal(cpfValido("529.982.247-26"), false);
+  assert.equal(cpfValido("111.111.111-11"), false);
+  assert.equal(cpfValido("123"), false);
+  assert.equal(cpfValido(""), false);
+});
+
+test("idade na data de início (limites de aniversário)", () => {
+  const ref = "2027-02-12";
+  assert.equal(calcularIdade("2022-02-12", ref), 5); // faz 5 no dia do início
+  assert.equal(calcularIdade("2022-02-13", ref), 4); // faz 5 um dia depois
+  assert.equal(calcularIdade("2017-02-12", ref), 10);
+  assert.equal(calcularIdade("2017-02-13", ref), 9);
+  assert.equal(calcularIdade("2009-02-12", ref), 18);
+  assert.equal(calcularIdade("2009-02-13", ref), 17);
+  assert.equal(calcularIdade("2024-02-29", ref), 2); // bissexto
+  assert.equal(calcularIdade("2023-02-30", ref), null); // data inexistente
+});
+
+test("faixas de valor: 4→a definir, 5→200, 9→200, 10→400, 60→400", () => {
+  const v = (i: number) => faixaPorIdade(i, evento.faixas)?.valor;
+  assert.equal(v(0), null);
+  assert.equal(v(4), null);
+  assert.equal(v(5), 200);
+  assert.equal(v(9), 200);
+  assert.equal(v(10), 400);
+  assert.equal(v(60), 400);
+});
+
+test("adulto válido: sem erros, R$ 400", () => {
+  const r = validar(base(), ctx);
+  assert.deepEqual(r.erros, {});
+  assert.equal(r.valor, 400);
+  assert.equal(r.menorDeIdade, false);
+});
+
+test("criança de 7 anos: R$ 200 e exige responsável", () => {
+  const r = validar(base({ dataNascimento: "2019-08-01" }), ctx);
+  assert.equal(r.idade, 7);
+  assert.equal(r.valor, 200);
+  assert.equal(r.menorDeIdade, true);
+  assert.ok(r.erros.responsavelNome);
+  assert.ok(r.erros.responsavelTelefone);
+  const ok = validar(
+    base({
+      dataNascimento: "2019-08-01",
+      responsavelNome: "Ana Souza",
+      responsavelTelefone: "35977776666",
+    }),
+    ctx,
+  );
+  assert.deepEqual(ok.erros, {});
+});
+
+test("menor de 5 anos: valor nulo (a definir), sem cobrança automática", () => {
+  const r = validar(
+    base({
+      dataNascimento: "2024-01-10",
+      responsavelNome: "Ana Souza",
+      responsavelTelefone: "35977776666",
+    }),
+    ctx,
+  );
+  assert.equal(r.idade, 3);
+  assert.equal(r.valor, null);
+  assert.deepEqual(r.erros, {});
+});
+
+test("nascimento no futuro e aceites obrigatórios", () => {
+  const r = validar(
+    base({ dataNascimento: "2026-12-01", aceiteRegras: false, aceitePrivacidade: false }),
+    ctx,
+  );
+  assert.ok(r.erros.dataNascimento);
+  assert.ok(r.erros.aceiteRegras);
+  assert.ok(r.erros.aceitePrivacidade);
+});
+
+test("e-mail é opcional, mas validado quando informado", () => {
+  assert.equal(validar(base({ email: "" }), ctx).erros.email, undefined);
+  assert.ok(validar(base({ email: "abc" }), ctx).erros.email);
+  assert.equal(validar(base({ email: "a@b.com" }), ctx).erros.email, undefined);
+});
+
+test("telefones e máscaras", () => {
+  assert.equal(telefoneValido("(35) 99999-1234"), true);
+  assert.equal(telefoneValido("+55 35 99999-1234"), true);
+  assert.equal(telefoneValido("(35) 3333-4444"), true);
+  assert.equal(telefoneValido("(35) 89999-1234"), false);
+  assert.equal(telefoneValido("(05) 99999-1234"), false);
+  assert.equal(normalizarTelefone("+55 (35) 99999-1234"), "35999991234");
+  assert.equal(formatarTelefone("35999991234"), "(35) 99999-1234");
+  assert.equal(formatarCpf("52998224725"), "529.982.247-25");
+});
+
+test("planilha: injeção de fórmula é neutralizada", () => {
+  assert.equal(higienizarCelula('=HYPERLINK("http://x")'), '\'=HYPERLINK("http://x")');
+  assert.equal(higienizarCelula("  Maria   Silva "), "Maria Silva");
+});
+
+test("corpo da planilha: CPF só dígitos, status de pagamento não confirmado", () => {
+  const v = base();
+  const r = validar(v, ctx);
+  const c = montarCorpo(v, r, {
+    idempotencyKey: "k1",
+    enviadoEm: "2026-10-21T00:00:00Z",
+    versaoTermos: "t",
+  });
+  assert.equal(c.cpf, "52998224725");
+  assert.equal(c.valor, 400);
+  assert.equal(c.statusPagamento, "NÃO CONFIRMADO");
+  assert.equal(c.menorDeIdade, "NÃO");
+  assert.equal(c.responsavelNome, "");
+});
diff --git a/tests/servidor.test.ts b/tests/servidor.test.ts
new file mode 100644
index 0000000..b2ffd8b
--- /dev/null
+++ b/tests/servidor.test.ts
@@ -0,0 +1,184 @@
+// Testa o servidor de inscrição contra um MOCK local do Apps Script
+// (redirect 302 como no Google). Não fala com a planilha real.
+// Rodar: npx tsx --test tests/*.test.ts
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import http from "node:http";
+import type { AddressInfo } from "node:net";
+
+import { processarInscricao } from "../src/server/inscricao.server.ts";
+import { VALORES_VAZIOS, cpfValido, type FormValues } from "../src/lib/inscricao.ts";
+
+let servidor: http.Server;
+let url = "";
+let modo: "ok" | "duplicado" | "html" | "lento" | "falha-json" = "ok";
+const recebidos: Record<string, unknown>[] = [];
+
+before(async () => {
+  servidor = http.createServer((req, res) => {
+    if (req.method === "POST" && req.url === "/macros/s/ABC/exec") {
+      let corpo = "";
+      req.on("data", (c) => (corpo += c));
+      req.on("end", () => {
+        recebidos.push(JSON.parse(corpo));
+        res.writeHead(302, { location: `/echo?m=${modo}` });
+        res.end();
+      });
+      return;
+    }
+    if (req.url?.startsWith("/echo")) {
+      const m = new URL(req.url, "http://x").searchParams.get("m");
+      if (m === "lento") return; // nunca responde → timeout
+      if (m === "html") {
+        res.writeHead(200, { "content-type": "text/html" });
+        return void res.end(
+          "<html><head><title>Error</title></head><body>Script function not found: doPost</body></html>",
+        );
+      }
+      res.writeHead(200, { "content-type": "application/json" });
+      if (m === "duplicado") return void res.end(JSON.stringify({ ok: false, code: "DUPLICATE" }));
+      if (m === "falha-json") return void res.end(JSON.stringify({ ok: false, error: "x" }));
+      return void res.end(JSON.stringify({ ok: true }));
+    }
+    res.writeHead(404);
+    res.end();
+  });
+  await new Promise<void>((r) => servidor.listen(0, "127.0.0.1", r));
+  url = `http://127.0.0.1:${(servidor.address() as AddressInfo).port}/macros/s/ABC/exec`;
+});
+after(() => servidor.close());
+
+const valores = (cpf: string, extra: Partial<FormValues> = {}): FormValues => ({
+  ...VALORES_VAZIOS,
+  nomeCompleto: "Maria da Silva",
+  dataNascimento: "1995-06-15",
+  cpf,
+  telefone: "(35) 99999-1234",
+  whatsapp: "(35) 99999-1234",
+  igreja: "Primeira Assembleia de Deus",
+  cidade: "Santa Rita do Sapucaí",
+  emergenciaNome: "José da Silva",
+  emergenciaTelefone: "(35) 98888-4321",
+  aceiteRegras: true,
+  aceitePrivacidade: true,
+  ...extra,
+});
+
+for (const c of [
+  "529.982.247-25",
+  "111.444.777-35",
+  "390.533.447-05",
+  "123.456.789-09",
+  "935.411.347-80",
+])
+  assert.equal(cpfValido(c), true, `CPF de teste inválido: ${c}`);
+
+test("sucesso: grava corpo correto e devolve nome, faixa e valor", async () => {
+  modo = "ok";
+  recebidos.length = 0;
+  const r = await processarInscricao(
+    { values: valores("529.982.247-25"), idempotencyKey: "chave-0001-aaaa" },
+    { url, token: "segredo" },
+  );
+  assert.equal(r.ok, true);
+  if (r.ok) {
+    assert.equal(r.nome, "Maria da Silva");
+    assert.equal(r.valor, 400);
+  }
+  assert.equal(recebidos.length, 1);
+  assert.equal(recebidos[0].cpf, "52998224725");
+  assert.equal(recebidos[0].token, "segredo");
+  assert.equal(recebidos[0].statusPagamento, "NÃO CONFIRMADO");
+  assert.equal(recebidos[0].valor, 400);
+});
+
+test("mesmo envio repetido (duplo clique) não grava duas vezes", async () => {
+  modo = "ok";
+  recebidos.length = 0;
+  const entrada = { values: valores("111.444.777-35"), idempotencyKey: "chave-0002-bbbb" };
+  const a = await processarInscricao(entrada, { url });
+  const b = await processarInscricao(entrada, { url });
+  assert.equal(a.ok && b.ok, true);
+  assert.equal(recebidos.length, 1);
+});
+
+test("mesmo CPF com outra chave logo depois é bloqueado sem ir à planilha", async () => {
+  recebidos.length = 0;
+  const r = await processarInscricao(
+    { values: valores("111.444.777-35"), idempotencyKey: "chave-0003-cccc" },
+    { url },
+  );
+  assert.equal(r.ok, false);
+  if (!r.ok) assert.equal(r.codigo, "DUPLICADO");
+  assert.equal(recebidos.length, 0);
+});
+
+test("planilha responde DUPLICATE → mensagem de duplicidade", async () => {
+  modo = "duplicado";
+  const r = await processarInscricao(
+    { values: valores("390.533.447-05"), idempotencyKey: "chave-0004-dddd" },
+    { url },
+  );
+  assert.equal(r.ok, false);
+  if (!r.ok) assert.equal(r.codigo, "DUPLICADO");
+});
+
+test("resposta HTML de erro do Apps Script NÃO vira sucesso", async () => {
+  modo = "html";
+  const r = await processarInscricao(
+    { values: valores("123.456.789-09"), idempotencyKey: "chave-0005-eeee" },
+    { url },
+  );
+  assert.equal(r.ok, false);
+  if (!r.ok) assert.equal(r.codigo, "NAO_CONFIRMADO");
+});
+
+test("recusa explícita em JSON → erro, não sucesso", async () => {
+  modo = "falha-json";
+  const r = await processarInscricao(
+    { values: valores("935.411.347-80"), idempotencyKey: "chave-0006-ffff" },
+    { url },
+  );
+  assert.equal(r.ok, false);
+  if (!r.ok) assert.equal(r.codigo, "RECUSADO");
+});
+
+test("timeout → não confirmado", async () => {
+  modo = "lento";
+  const r = await processarInscricao(
+    { values: valores("935.411.347-80"), idempotencyKey: "chave-0007-gggg" },
+    { url },
+    { timeoutMs: 300 },
+  );
+  assert.equal(r.ok, false);
+  if (!r.ok) assert.equal(r.codigo, "NAO_CONFIRMADO");
+});
+
+test("dados inválidos nunca chegam à planilha; honeypot e ambiente sem URL", async () => {
+  modo = "ok";
+  recebidos.length = 0;
+  const ruim = await processarInscricao(
+    { values: valores("111.111.111-11"), idempotencyKey: "chave-0008-hhhh" },
+    { url },
+  );
+  assert.equal(ruim.ok, false);
+  if (!ruim.ok) {
+    assert.equal(ruim.codigo, "VALIDACAO");
+    assert.ok(ruim.erros?.cpf);
+  }
+  const robo = await processarInscricao(
+    {
+      values: valores("529.982.247-25", { website: "http://spam" }),
+      idempotencyKey: "chave-0009-iiii",
+    },
+    { url },
+  );
+  assert.equal(robo.ok, false);
+  const semUrl = await processarInscricao(
+    { values: valores("529.982.247-25"), idempotencyKey: "chave-0010-jjjj" },
+    {},
+  );
+  assert.equal(semUrl.ok, false);
+  if (!semUrl.ok) assert.equal(semUrl.codigo, "NAO_CONFIGURADO");
+  assert.equal(recebidos.length, 0);
+});
