+  flex-wrap: wrap;
+  gap: 0.85rem;
+  margin-top: 2rem;
+}
+@media (min-width: 48rem) {
+  .lp-facts {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    max-width: 44rem;
+  }
+}
+
+/* ─── Cartões ─────────────────────────────────────────────────────────── */
+.lp-grid {
+  display: grid;
+  gap: 1rem;
+}
+@media (min-width: 40rem) {
+  .lp-grid.c2,
+  .lp-grid.c4 {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+@media (min-width: 64rem) {
+  .lp-grid.c4 {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+  }
+  .lp-grid.c3 {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+.lp-card {
+  background: var(--lp-card);
+  border: 1px solid var(--lp-line);
+  border-radius: var(--lp-radius);
+  padding: 1.5rem;
+}
+.lp-card h3 {
+  font-family: var(--lp-head);
+  font-weight: 700;
+  font-size: 1.25rem;
+  margin: 0.9rem 0 0.4rem;
+}
+.lp-card p {
+  margin: 0;
+  color: var(--lp-mute);
+}
+.lp-ico {
+  display: inline-grid;
+  place-items: center;
+  width: 3rem;
+  height: 3rem;
+  border-radius: 14px;
+  background: rgba(255, 90, 31, 0.14);
+  color: var(--lp-fire);
+}
+.lp-ico.sky {
+  background: rgba(98, 170, 255, 0.14);
+  color: var(--lp-sky);
+}
+.lp-badge {
+  display: inline-block;
+  margin-left: 0.5rem;
+  padding: 0.15rem 0.6rem;
+  border-radius: 999px;
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  vertical-align: middle;
+  font-family: var(--font-sans, "Inter", sans-serif);
+}
+.lp-badge.ok {
+  background: rgba(79, 209, 160, 0.14);
+  color: var(--lp-ok);
+}
+.lp-badge.pend {
+  background: rgba(255, 176, 46, 0.14);
+  color: var(--lp-amber);
+}
+.lp-list {
+  margin: 0.75rem 0 0;
+  padding-left: 1.15rem;
+  color: var(--lp-mute);
+}
+.lp-list li {
+  margin: 0.4rem 0;
+}
+
+/* Valores */
+.lp-prices {
+  list-style: none;
+  margin: 0.9rem 0 0;
+  padding: 0;
+  display: grid;
+  gap: 0.5rem;
