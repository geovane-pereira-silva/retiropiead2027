+.lp-title em {
+  font-style: normal;
+  background: var(--lp-grad);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.lp-tema {
+  margin: 1rem 0 0;
+  font-family: var(--lp-head);
+  font-weight: 600;
+  font-size: clamp(1.1rem, 3.4vw, 1.6rem);
