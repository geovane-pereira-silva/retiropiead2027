@@ -0,0 +1,987 @@
+/* ==========================================================================
+   Landing pública do retiro — todas as classes usam o prefixo `lp-`
+   para não colidir com os estilos da apresentação executiva (/deck).
+   ========================================================================== */
+
+.lp {
+  --lp-bg: #090a12;
+  --lp-bg2: #0e1020;
+  --lp-card: #141729;
+  --lp-card2: #1a1e35;
+  --lp-ink: #f5f1ea;
+  --lp-mute: #aab0c6;
+  --lp-line: rgba(255, 255, 255, 0.11);
+  --lp-fire: #ff5a1f;
+  --lp-amber: #ffb02e;
+  --lp-sky: #62aaff;
+  --lp-ok: #4fd1a0;
+  --lp-err: #ff7b7b;
+  --lp-grad: linear-gradient(135deg, #ff4d1a 0%, #ff8a1f 55%, #ffc23d 100%);
+  --lp-radius: 18px;
+  --lp-head: "Bricolage Grotesque", "Inter", ui-sans-serif, system-ui, sans-serif;
+
+  background: var(--lp-bg);
+  color: var(--lp-ink);
+  font-family: var(--font-sans, "Inter", ui-sans-serif, system-ui, sans-serif);
+  line-height: 1.6;
+  min-height: 100vh;
+  overflow-x: clip;
+  -webkit-font-smoothing: antialiased;
+}
+.lp *,
+.lp *::before,
+.lp *::after {
+  box-sizing: border-box;
+}
+.lp a {
+  color: inherit;
+}
+.lp :focus-visible {
+  outline: 3px solid var(--lp-amber);
+  outline-offset: 3px;
+  border-radius: 6px;
+}
+
+.lp-wrap {
+  width: 100%;
+  max-width: 72rem;
+  margin: 0 auto;
+  padding: 0 1.25rem;
+}
+.lp-section {
+  padding: clamp(3.5rem, 8vw, 6.5rem) 0;
+  scroll-margin-top: 4.5rem;
+}
