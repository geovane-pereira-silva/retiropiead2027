+.lp-prices b {
+  font-family: var(--lp-head);
+  font-size: 1.25rem;
+  white-space: nowrap;
+}
+.lp-prices span.tbd {
+  color: var(--lp-mute);
+  font-size: 0.9rem;
+  text-align: right;
+}
+
+/* ─── Galeria ─────────────────────────────────────────────────────────── */
+.lp-tabs {
+  display: flex;
+  gap: 0.5rem;
