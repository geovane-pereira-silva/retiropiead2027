+.lp-btn[disabled] {
+  opacity: 0.6;
+  cursor: not-allowed;
+  transform: none;
+}
+.lp-btn-big {
+  min-height: 3.75rem;
+  padding: 1rem 2.2rem;
+  font-size: 1.1rem;
+}
+
+/* ─── Navegação ───────────────────────────────────────────────────────── */
+.lp-nav {
+  position: sticky;
+  top: 0;
+  z-index: 50;
+  background: color-mix(in oklab, var(--lp-bg) 82%, transparent);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+  border-bottom: 1px solid var(--lp-line);
+}
+.lp-nav-in {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  min-height: 4rem;
+}
+.lp-brand {
+  display: flex;
+  flex-direction: column;
+  line-height: 1.1;
+  text-decoration: none;
+}
+.lp-brand b {
+  font-family: var(--lp-head);
+  font-weight: 800;
+  font-size: 1.15rem;
+  letter-spacing: -0.01em;
+}
+.lp-brand span {
+  font-size: 0.68rem;
+  color: var(--lp-mute);
+  letter-spacing: 0.04em;
+}
+.lp-links {
+  display: none;
+  align-items: center;
+  gap: 1.5rem;
+}
+.lp-links a {
+  text-decoration: none;
+  font-size: 0.92rem;
+  font-weight: 500;
+  color: var(--lp-mute);
+}
+.lp-links a:hover {
