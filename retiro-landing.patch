+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+.lp-photo {
+  position: relative;
+  aspect-ratio: 4 / 3;
+  border-radius: 14px;
+  overflow: hidden;
+  border: 1px solid var(--lp-line);
