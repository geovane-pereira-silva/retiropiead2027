+  color: var(--lp-ink);
+  cursor: pointer;
+}
+
+/* ─── Programação ─────────────────────────────────────────────────────── */
+.lp-day {
+  background: var(--lp-card);
+  border: 1px solid var(--lp-line);
+  border-radius: var(--lp-radius);
+  padding: 1.5rem;
+}
+.lp-day h3 {
+  font-family: var(--lp-head);
+  margin: 0 0 0.25rem;
+  font-size: 1.35rem;
+}
+.lp-day small {
