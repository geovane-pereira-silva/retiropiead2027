+  display: block;
+  transition: transform 0.4s ease;
+}
+.lp-photo:hover img {
+  transform: scale(1.04);
+}
+.lp-empty {
+  display: grid;
+  place-items: center;
+  gap: 0.6rem;
+  text-align: center;
+  padding: 2.5rem 1.25rem;
+  border: 1px dashed rgba(255, 255, 255, 0.22);
+  border-radius: var(--lp-radius);
+  color: var(--lp-mute);
+  background: repeating-linear-gradient(
+    135deg,
+    rgba(255, 255, 255, 0.02) 0 14px,
+    transparent 14px 28px
+  );
+}
+.lp-empty svg {
+  color: var(--lp-amber);
+}
+.lp-video {
+  position: relative;
+  aspect-ratio: 16 / 9;
+  border-radius: 14px;
+  overflow: hidden;
+  border: 1px solid var(--lp-line);
+  background: #000;
+}
+.lp-video iframe {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  border: 0;
+}
+.lp-videos {
+  display: grid;
+  gap: 1rem;
+}
+@media (min-width: 48rem) {
+  .lp-videos {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
