# Variáveis de ambiente do SERVIDOR (nunca use o prefixo VITE_ e nunca faça commit dos valores reais).
# Configure-as no painel de segredos/variáveis da hospedagem (ex.: Lovable Cloud / Cloudflare).

# URL do web app do Google Apps Script que grava na planilha (termina em /exec). OBRIGATÓRIA.
APPS_SCRIPT_URL=

# Segredo opcional: se preenchido, é enviado no corpo como "token" e o script pode recusar quem não o tiver.
# Se usar, defina a mesma chave em Propriedades do script → TOKEN (veja docs/apps-script/Code.gs).
APPS_SCRIPT_TOKEN=
